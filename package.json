{
  "name": "coalesce-local-vscode",
  "displayName": "Coalesce Local UI",
  "description": "Run `coa serve` in the background and open the Coalesce UI in an editor tab instead of an external browser.",
  "version": "0.2.0",
  "license": "MIT",
  "publisher": "local",
  "repository": {
    "type": "git",
    "url": "https://github.com/markvdh/coalesce-local-vscode.git"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "media/icon.png",
  "main": "./extension.js",
  "scripts": {
    "test": "node test/fsutil.test.js && node test/coaconfig.test.js && node test/workspaceyml.test.js && node test/serve.unit.test.js",
    "test:e2e": "node test/serve.test.js"
  },
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "coalesceServe",
          "title": "Coalesce Local UI",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "coalesceServe": [
        {
          "id": "coalesceServe.control",
          "name": "Local UI"
        }
      ]
    },
    "commands": [
      {
        "command": "coalesceServe.open",
        "title": "Coalesce: Open Local UI",
        "icon": "$(play)"
      },
      {
        "command": "coalesceServe.stop",
        "title": "Coalesce: Stop Local UI Server",
        "icon": "$(debug-stop)"
      },
      {
        "command": "coalesceServe.restart",
        "title": "Coalesce: Restart Local UI Server",
        "icon": "$(debug-restart)"
      },
      {
        "command": "coalesceServe.showLog",
        "title": "Coalesce: Show Local UI Server Log",
        "icon": "$(output)"
      },
      {
        "command": "coalesceServe.refresh",
        "title": "Coalesce: Reload Profiles",
        "icon": "$(refresh)"
      },
      {
        "command": "coalesceServe.newProfile",
        "title": "Coalesce: New Profile…",
        "icon": "$(add)"
      },
      {
        "command": "coalesceServe.editProfile",
        "title": "Coalesce: Edit Profile…",
        "icon": "$(edit)"
      },
      {
        "command": "coalesceServe.activateProfile",
        "title": "Coalesce: Use Profile For This Workspace",
        "icon": "$(check)"
      },
      {
        "command": "coalesceServe.deleteProfile",
        "title": "Coalesce: Delete Profile",
        "icon": "$(trash)"
      },
      {
        "command": "coalesceServe.editCloudField",
        "title": "Coalesce: Edit Cloud Setting…",
        "icon": "$(edit)"
      },
      {
        "command": "coalesceServe.openConfigFile",
        "title": "Coalesce: Open ~/.coa/config",
        "icon": "$(go-to-file)"
      },
      {
        "command": "coalesceServe.openWorkspaceFile",
        "title": "Coalesce: Open workspace.yml",
        "icon": "$(go-to-file)"
      },
      {
        "command": "coalesceServe.initWorkspace",
        "title": "Coalesce: Initialise Workspace (coa init)",
        "icon": "$(terminal)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "coalesceServe.editProfile",
          "when": "false"
        },
        {
          "command": "coalesceServe.activateProfile",
          "when": "false"
        },
        {
          "command": "coalesceServe.deleteProfile",
          "when": "false"
        },
        {
          "command": "coalesceServe.editCloudField",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "coalesceServe.open",
          "when": "view == coalesceServe.control && !coalesceServe.running",
          "group": "navigation@1"
        },
        {
          "command": "coalesceServe.restart",
          "when": "view == coalesceServe.control && coalesceServe.running",
          "group": "navigation@1"
        },
        {
          "command": "coalesceServe.stop",
          "when": "view == coalesceServe.control && coalesceServe.running",
          "group": "navigation@2"
        },
        {
          "command": "coalesceServe.newProfile",
          "when": "view == coalesceServe.control",
          "group": "navigation@3"
        },
        {
          "command": "coalesceServe.refresh",
          "when": "view == coalesceServe.control",
          "group": "navigation@4"
        },
        {
          "command": "coalesceServe.showLog",
          "when": "view == coalesceServe.control",
          "group": "1_more@1"
        },
        {
          "command": "coalesceServe.openConfigFile",
          "when": "view == coalesceServe.control",
          "group": "1_more@2"
        },
        {
          "command": "coalesceServe.openWorkspaceFile",
          "when": "view == coalesceServe.control",
          "group": "1_more@3"
        }
      ],
      "view/item/context": [
        {
          "command": "coalesceServe.activateProfile",
          "when": "view == coalesceServe.control && viewItem == profile",
          "group": "0_use@1"
        },
        {
          "command": "coalesceServe.editProfile",
          "when": "view == coalesceServe.control && viewItem =~ /^profile/",
          "group": "inline@1"
        },
        {
          "command": "coalesceServe.deleteProfile",
          "when": "view == coalesceServe.control && viewItem =~ /^profile/",
          "group": "inline@2"
        },
        {
          "command": "coalesceServe.editCloudField",
          "when": "view == coalesceServe.control && viewItem == cloudField",
          "group": "inline@1"
        },
        {
          "command": "coalesceServe.newProfile",
          "when": "view == coalesceServe.control && viewItem == group.profiles",
          "group": "inline@1"
        }
      ]
    },
    "configuration": {
      "title": "Coalesce Local UI",
      "properties": {
        "coalesceServe.coaPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `coa` executable. Leave empty to auto-detect: the Coalesce Desktop shim (`~/.coalesce/desktop/coa`, or `coa.cmd`/`coa.exe`/`coa.bat` on Windows) is preferred, otherwise `coa` from `PATH`."
        },
        "coalesceServe.port": {
          "type": "number",
          "default": 8082,
          "description": "Preferred port for `coa serve`. If it is already taken, the next free port is used."
        },
        "coalesceServe.workspaceFolder": {
          "type": "string",
          "default": "",
          "description": "Workspace folder (name or absolute path) to serve. Leave empty to use the folder containing workspace.yml, else the one containing data.yml, else the first folder."
        },
        "coalesceServe.showStatusBarItem": {
          "type": "boolean",
          "default": true,
          "description": "Show a status bar item while the local UI server is running."
        }
      }
    }
  }
}
